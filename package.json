{
  "name": "@ratmath/symbolic",
  "version": "0.2.0",
  "description": "Symbolic algebra for RatMath: expressions, rewriting, solving and closed forms, with every step checked by the certified libraries",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/llms.txt"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "bun test ./tests",
    "docs:build": "bun scripts/build-docs.js && node scripts/build-llms.mjs",
    "docs:llms": "node scripts/build-llms.mjs"
  },
  "keywords": [
    "symbolic",
    "computer-algebra",
    "simplify",
    "solve",
    "exact",
    "ratmath"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratmath/symbolic.git"
  },
  "homepage": "https://ratmath.com/symbolic/",
  "bugs": {
    "url": "https://github.com/ratmath/symbolic/issues"
  },
  "dependencies": {
    "@ratmath/algebraic": "^0.1.0",
    "@ratmath/analytic": "^0.1.0",
    "@ratmath/structures": "^0.5.0"
  },
  "peerDependencies": {
    "@ratmath/core": ">=0.10.0 <0.12.0"
  },
  "devDependencies": {
    "@ratmath/core": "^0.11.0",
    "katex": "0.19.1"
  },
  "types": "index.d.ts",
  "author": "James Taylor",
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "vendor/analytic",
    "vendor/algebraic",
    "vendor/structures",
    "vendor/linalg"
  ]
}
